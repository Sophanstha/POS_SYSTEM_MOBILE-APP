.env
.env*.local

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# Test coverage
coverage/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code (personal settings only; .claude/settings.json is shared)
.claude/settings.local.json

